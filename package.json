{
  "name": "llm-switcher",
  "version": "1.0.0",
  "description": "Windows system tray app to open LLM services in specific Chrome profiles",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . \"LLM Switcher\" --platform=win32 --arch=x64 --icon=llm_switcher.ico --out=dist --overwrite",
    "dist": "npm run build",
    "test": "node --test",
    "lint": "eslint main.js config.js windows.js browsers.js preload.js renderer.js settings_renderer.js settings",
    "format": "prettier --write ."
  },
  "keywords": [
    "chrome",
    "profile",
    "llm",
    "switcher",
    "tray"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2"
  },
  "build": {
    "appId": "com.torres.llm-switcher",
    "productName": "LLM Switcher",
    "forceCodeSigning": false,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "llm_switcher.ico",
      "sign": null
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "config.js",
      "windows.js",
      "browsers.js",
      "preload.js",
      "index.html",
      "index.css",
      "renderer.js",
      "settings.html",
      "settings.css",
      "settings/store.js",
      "settings/mappings.js",
      "settings/services.js",
      "settings/profiles.js",
      "settings/preferences.js",
      "settings_renderer.js",
      "llm_switcher.ico"
    ]
  }
}
